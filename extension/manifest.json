{
  "manifest_version": 2,
  "name": "OneBNB: Airbnb Prices, Shortlist & Chat",
  "version": "0.1.27",
  "description": "Your whole Airbnb search on one screen: true nightly prices, hide what you've ruled out, star and note the rest, and chat without leaving the results. Beta, under active development. Unofficial: not affiliated with Airbnb, Inc.",
  "homepage_url": "https://github.com/noamzilo/airbnb_filter",
  "browser_specific_settings": {
    "gecko": {
      "id": "airbnb-archiver@noam.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://*.airbnb.com/*"
  ],
  "background": {
    "scripts": [
      "filter.js",
      "background.js"
    ],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.airbnb.com/*"
      ],
      "js": [
        "filter.js",
        "store.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon-48.png",
    "96": "icon-96.png",
    "128": "icon-128.png"
  },
  "browser_action": {
    "default_title": "Airbnb Archiver",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  }
}
