{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/no_em_dash_hook.js\"",
            "timeout": 10,
            "statusMessage": "Checking for em dashes"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/subagent_autoship_hook.js\"",
            "timeout": 15,
            "statusMessage": "Checking for unshipped extension changes"
          }
        ]
      }
    ]
  }
}
